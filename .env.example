# Copy to .env and fill in real values. Never commit .env.

# --- Core ---
ENV=development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=acmecorp
ADMIN_API_TOKEN=change-me-to-a-long-random-string
# Backend CORS: must match the Next.js origin exactly (default port 3000).
FRONTEND_ORIGIN=http://localhost:3000
# DEMO_TODAY=2026-11-05   # optional YYYY-MM-DD; unset = use real local date
# Ports: backend http://localhost:8000 , frontend http://localhost:3000

# --- Email (Part B) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
EMAIL_FROM_NAME=AcmeCorp Accounts Team
REMINDER_COOLDOWN_HOURS=72
EMAIL_DRY_RUN=true
ENABLE_REMINDER_SCHEDULER=false
ENABLE_INBOX_POLL=false
INBOX_POLL_SECONDS=120

# --- LLM (Part B) ---
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash
LLM_MIN_CONFIDENCE=0.75
MAX_EMAIL_BODY_CHARS=12000

# --- Matching (Part C) ---
ENABLE_EMBEDDINGS=false
ENABLE_LLM_MATCH_ASSIST=false
MATCH_USE_EMBEDDINGS=false
MATCH_USE_LLM=false
