# Copy to .env and fill in real values. Never commit .env.

# --- Core ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=acmecorp
ADMIN_API_TOKEN=change-me-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:3000
# DEMO_TODAY=2026-11-05   # optional YYYY-MM-DD; unset = use real local date

# --- Email (Part B; unused in Phase 1) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
EMAIL_FROM_NAME=AcmeCorp Accounts Team
REMINDER_COOLDOWN_HOURS=24

# --- LLM (Part B; unused in Phase 1) ---
LLM_PROVIDER=openai_compatible
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash

# --- Matching (Part C; unused in Phase 1) ---
MATCH_USE_EMBEDDINGS=false
MATCH_USE_LLM=false
