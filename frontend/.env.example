# Server-only (never NEXT_PUBLIC_). Copied to .env.local for local dev.
# These are read by the Next.js proxy route handlers only.

# FastAPI base URL (no trailing slash). Default backend port: 8000.
BACKEND_URL=http://localhost:8000

# Must match backend ADMIN_API_TOKEN. Injected as X-Admin-Token by the proxy.
ADMIN_TOKEN=change-me-to-a-long-random-string
